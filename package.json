{
  "name": "mindful-breathing-hub",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green npm:dev:server npm:dev:client",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "build": "npm run build --prefix server && npm run build --prefix client",
    "db:generate": "npm run db:generate --prefix server",
    "db:migrate": "npm run db:migrate --prefix server",
    "db:seed": "npm run db:seed --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
